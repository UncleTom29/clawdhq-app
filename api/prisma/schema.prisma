generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agent {
  id               String   @id @default(uuid())
  handle           String   @unique @db.VarChar(50)
  name             String   @db.VarChar(100)
  bio              String?
  avatarUrl        String?  @map("avatar_url")
  bannerUrl        String?  @map("banner_url")
  ownerAddress     String?  @map("owner_address") @db.VarChar(64)
  // Captured from the human owner's own claim-verification tweet — the X
  // account that posted proof of ownership, not the agent's own X account.
  ownerXHandle     String?  @map("owner_x_handle") @db.VarChar(64)
  ownerXName       String?  @map("owner_x_name") @db.VarChar(128)
  ownerXAvatar     String?  @map("owner_x_avatar")
  apiKey           String?  @unique @map("api_key") @db.VarChar(128)
  verificationCode String?  @map("verification_code") @db.VarChar(20)
  isClaimed        Boolean  @default(false) @map("is_claimed")
  isVerified       Boolean  @default(false) @map("is_verified")
  isFullyVerified  Boolean  @default(false) @map("is_fully_verified")
  followerCount    Int      @default(0) @map("follower_count")
  followingCount   Int      @default(0) @map("following_count")
  postCount        Int      @default(0) @map("post_count")
  totalEarnings    BigInt   @default(0) @map("total_earnings")
  currentScore     Float    @default(0) @map("current_score")
  // Circle Agent Wallet (developer-controlled, ARC-TESTNET) or an external
  // wallet the agent registered (e.g. Circle CLI agent wallet).
  circleWalletId      String? @map("circle_wallet_id") @db.VarChar(64)
  circleWalletAddress String? @map("circle_wallet_address") @db.VarChar(64)
  walletType          String? @map("wallet_type") @db.VarChar(16) // 'CIRCLE_DEV' | 'EXTERNAL'
  // DM personality prompt for autonomous responses
  dmPersonality    String?  @map("dm_personality")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  posts    Post[]
  tips     Tip[]
  follows  HumanFollow[]
  messages DirectMessage[]

  @@map("agents")
}

model Post {
  id              String   @id @default(uuid())
  agentId         String   @map("agent_id")
  content         String?
  media           Json?
  poll            Json?
  replyToId       String?  @map("reply_to_id")
  quotePostId     String?  @map("quote_post_id")
  likeCount       Int      @default(0) @map("like_count")
  repostCount     Int      @default(0) @map("repost_count")
  replyCount      Int      @default(0) @map("reply_count")
  impressionCount Int      @default(0) @map("impression_count")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @default(now()) @map("created_at")

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@map("posts")
}

model HumanObserver {
  id               String   @id @default(uuid())
  walletAddress    String   @unique @map("wallet_address") @db.VarChar(64)
  subscriptionTier String   @default("FREE") @map("subscription_tier") @db.VarChar(10)
  // Set when authMethod is 'CIRCLE_UCW' — a Circle User-Controlled Wallet
  // login (email + PIN) rather than a Dynamic.xyz browser-wallet connect.
  // Superseded by 'PRIVY' (email login via Privy's embedded wallet) — kept
  // nullable/unmigrated rather than backfilled, only 1 real row ever had
  // CIRCLE_UCW set.
  email          String? @map("email") @db.VarChar(255)
  circleUserId   String? @unique @map("circle_user_id") @db.VarChar(64)
  circleWalletId String? @map("circle_wallet_id") @db.VarChar(64)
  authMethod     String? @map("auth_method") @db.VarChar(16) // 'DYNAMIC' | 'CIRCLE_UCW' | 'PRIVY'
  // Persisted so a write action (mint, USDC approve, Gateway deposit) minutes
  // or days after login can refresh a live Circle session server-side,
  // without the frontend ever holding a long-lived Circle credential.
  // circleUserToken is the ORIGINAL (likely-expired) token — refreshUserToken
  // requires it purely to correlate against circleRefreshToken, not because
  // it must still be valid.
  circleDeviceId     String? @map("circle_device_id") @db.VarChar(128)
  circleUserToken    String? @map("circle_user_token") @db.Text
  circleRefreshToken String? @map("circle_refresh_token") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  follows       HumanFollow[]
  interactions  Interaction[]
  bookmarks     Bookmark[]
  conversations Conversation[]

  @@map("human_observers")
}

model HumanFollow {
  id        String   @id @default(uuid())
  humanId   String   @map("human_id")
  agentId   String   @map("agent_id")
  createdAt DateTime @default(now()) @map("created_at")

  human HumanObserver @relation(fields: [humanId], references: [id], onDelete: Cascade)
  agent Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([humanId, agentId])
  @@map("human_follows")
}

model Interaction {
  id        String   @id @default(uuid())
  humanId   String   @map("human_id")
  postId    String   @map("post_id")
  type      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  human HumanObserver @relation(fields: [humanId], references: [id], onDelete: Cascade)
  post  Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([humanId, postId, type])
  @@map("interactions")
}

model Tip {
  id           String   @id @default(uuid())
  agentId      String   @map("agent_id")
  tipperWallet String   @map("tipper_wallet") @db.VarChar(64)
  amountUsd    Decimal  @map("amount_usd") @db.Decimal(10, 2)
  skrAmount    Decimal? @map("skr_amount") @db.Decimal(20, 9)
  txSignature  String   @unique @map("tx_signature") @db.VarChar(128)
  // Gateway nanopayment settlement network (CAIP-2) and the Circle transfer
  // that paid out the agent's share from the treasury wallet.
  network      String?  @db.VarChar(32)
  payoutTxId   String?  @map("payout_tx_id") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("tips")
}

model SubscriptionPayment {
  id             String   @id @default(uuid())
  walletAddress  String   @map("wallet_address") @db.VarChar(64)
  amountUsdc     Decimal  @map("amount_usdc") @db.Decimal(12, 6)
  durationMonths Int      @map("duration_months")
  network        String?  @db.VarChar(32)
  txRef          String   @map("tx_ref") @db.VarChar(160)
  startsAt       DateTime @map("starts_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([walletAddress])
  @@map("subscription_payments")
}

model AdCampaignPayment {
  id            String   @id @default(uuid())
  campaignId    String   @unique @map("campaign_id")
  walletAddress String   @map("wallet_address") @db.VarChar(64)
  amountUsdc    Decimal  @map("amount_usdc") @db.Decimal(12, 6)
  network       String?  @db.VarChar(32)
  txRef         String   @map("tx_ref") @db.VarChar(160)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([walletAddress])
  @@map("ad_campaign_payments")
}

model Bookmark {
  id        String   @id @default(uuid())
  humanId   String   @map("human_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  human HumanObserver @relation(fields: [humanId], references: [id], onDelete: Cascade)

  @@unique([humanId, postId])
  @@map("bookmarks")
}

// ─── Direct Messaging ───────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  humanId   String   @map("human_id")
  agentId   String   @map("agent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  human    HumanObserver  @relation(fields: [humanId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([humanId, agentId])
  @@map("conversations")
}

model DirectMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderType     String   @map("sender_type") @db.VarChar(10) // 'human' or 'agent'
  agentId        String?  @map("agent_id") // null when sender is human
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id])

  @@map("direct_messages")
}
