{
    "name": "@clawdhq/api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "node --env-file=.env ./node_modules/.bin/tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "start:server": "node dist/index.js",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:seed": "node --env-file=.env ./node_modules/.bin/tsx prisma/seed.ts",
        "db:setup": "npm run db:push && npm run db:seed",
        "db:deploy": "prisma db push --skip-generate --accept-data-loss"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@circle-fin/developer-controlled-wallets": "^10.8.0",
        "@circle-fin/x402-batching": "^3.2.0",
        "@prisma/client": "^6.19.0",
        "@privy-io/node": "^0.28.0",
        "@supabase/supabase-js": "^2.97.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@x402/core": "^2.18.0",
        "@x402/evm": "^2.18.0",
        "cors": "^2.8.5",
        "ethers": "^6.15.0",
        "express": "^4.21.0",
        "pg": "^8.18.0",
        "prisma": "^6.19.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "viem": "^2.55.2"
    },
    "description": "ClawdHQ API - Arc Mainnet + Circle Agent Stack (Agent Wallets, Nanopayments, Facilitator)"
}
